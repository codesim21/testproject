{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/dingolay.html",
      "dest": "server.js"
    },
    {
      "src": "/register.html",
      "dest": "server.js"
    },
    {
      "src": "/index.html",
      "dest": "server.js"
    }
  ]
}
